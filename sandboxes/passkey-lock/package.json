{
  "name": "tea-passkey-lock-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "db:prepare": "node --experimental-strip-types scripts/prepare.mjs",
    "predev": "node --experimental-strip-types scripts/prepare.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3142",
    "build": "next build --webpack",
    "prestart": "node --experimental-strip-types scripts/prepare.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "security:audit": "pnpm audit --audit-level=high",
    "test": "node tests/run-local-fixtures.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.2"
  }
}
